# YADAV HOTEL AI AGENT PRO - environment template
# Copy this file to your deployment secret/configuration store.
# NEVER commit a real .env file or real credentials.

APP_ENV=production
LOG_LEVEL=INFO

# API runtime
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_DEBUG=false

# REQUIRED in production: replace with a unique random secret of at least 32 characters.
API_SECRET_KEY=replace-with-a-strong-random-production-secret
API_ACCESS_TOKEN_MINUTES=60

# Comma-separated explicit browser origins. Do not use * in production.
API_CORS_ORIGINS=https://your-hotel-domain.example
API_TRUSTED_HOSTS=your-hotel-domain.example
API_PROXY_HEADERS=true
API_FORWARDED_ALLOW_IPS=127.0.0.1
API_ACCESS_LOG=true
API_DOCS_ENABLED=false
API_FORCE_HTTPS=true
API_RATE_LIMIT_PER_MINUTE=120

# Production SQLite runtime
# Point these at persistent storage in production. Relative paths are not required.
HOTEL_DATABASE_PATH=data/hotel.db
HOTEL_DATABASE_BACKUP_DIR=data/backups
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL

# AI runtime
AI_AGENT_ENABLED=true
AI_AGENT_PROVIDER=your-provider
AI_AGENT_MODEL=your-model
# Required when AI_AGENT_ENABLED=true in production. Never commit real credentials.
AI_AGENT_API_KEY=replace-with-provider-api-key
AI_AGENT_API_SECRET=replace-with-provider-api-secret
AI_AGENT_TIMEOUT_SECONDS=30
AI_AGENT_MAX_RETRIES=2
AI_AGENT_RETRY_BACKOFF_SECONDS=0.25
AI_MAX_CONCURRENT_REQUESTS=20
HEALTH_CHECK_TIMEOUT_SECONDS=5
REQUIRE_PRODUCTION_SECRET=true

# AI operational logging
AI_FILE_LOGGING=true
AI_LOG_DIR=logs

# Phase 9.7 logging & monitoring
APP_LOG_DIR=logs
APP_FILE_LOGGING=true
AI_LOG_DIR=logs
AI_FILE_LOGGING=true
